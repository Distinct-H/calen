# 复制成 .env 后填写。.env 已在 .gitignore 里，不会被提交。

# ── 数据库 ───────────────────────────────────────────────
# 本地开发用 SQLite（零配置）
DATABASE_URL=sqlite:///./data/couple.db
# 生产环境用托管 Postgres，Railway 会自动注入这个变量，不要手填：
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── 密钥（生产环境必须换掉）────────────────────────────────
# 生成命令：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
CRON_SECRET=

# ── 其他 ─────────────────────────────────────────────────
DEFAULT_TIMEZONE=Asia/Shanghai

# 本地开发设 true：会开放 /api/docs，并允许 http 下的 Cookie。
# 生产环境必须为 false。
DEBUG=true
