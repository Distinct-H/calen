# 服务器上复制成 .env.prod 后填写。这个文件绝不要提交到 git。
#
# 三个密码/密钥都用这条命令生成，每个用不同的值：
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# 服务器上没装 python3 的话用：
#   openssl rand -base64 48 | tr -d '/+=' | cut -c1-48

# ── 数据库 ───────────────────────────────────────────────
POSTGRES_DB=couple
POSTGRES_USER=couple
POSTGRES_PASSWORD=

# ── 应用密钥 ─────────────────────────────────────────────
SESSION_SECRET=
CRON_SECRET=

# ── HTTPS 开关 ───────────────────────────────────────────
# 会话 Cookie 的 Secure 标记。
#
#   false = 用 http://服务器IP 访问的阶段（备案前）。必须是 false，
#           否则浏览器不保存 Cookie，登录会「提交后跳回登录页」且不报错。
#   true  = 配好域名和 HTTPS 证书之后改成这个，然后 dc up -d
SECURE_COOKIES=false

# ── 可选 ─────────────────────────────────────────────────
# 应用在宿主机上监听的回环端口。和别的服务冲突时改这里。
APP_PORT=8000

# 构建时的 PyPI 源。海外节点可以改成 https://pypi.org/simple
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
